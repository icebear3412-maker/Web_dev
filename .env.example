#Database Connection Configuration
#You can use a full connection URI (DATABASE_URL) or individual parameters

#Option 1: Full PostgreSQL connection URI
DATABASE_URL=postgresql://postgres:postgres@localhost:1000/cinema_db

#Option 2: Individual connection parameters (fallback if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=1000
POSTGRES_DB=cinema_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_VOLUME_NAME=backend_upload_pgdata

#Server Port
PORT=5000
# Docker exposes the site on this host port to avoid local Flask services on 5000.
HOST_PORT=2000

#Cookie settings: use false locally and true only when your production site uses HTTPS.
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

#Required: use separate random values of at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

#Set to true only for a local demo database. It creates accounts from data/database.json.
SEED_DEMO_DATA=false

#Optional: use once to create the first production administrator, then remove it.
#BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-strong-password
